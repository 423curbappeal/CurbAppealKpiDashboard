{
  "name": "ceo-os",
  "version": "2.0.0",
  "private": true,
  "description": "CEO OS 2.0 \u2014 an AI-assisted personal operating system for ambitious people.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --trace off",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capgo/capacitor-health": "^8.12.0",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.545.0",
    "next": "^15.5.29",
    "postgres": "^3.4.7",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "sharp": "^0.35.5"
  }
}
