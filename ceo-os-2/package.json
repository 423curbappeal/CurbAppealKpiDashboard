{
  "name": "ceo-os",
  "version": "2.0.0",
  "private": true,
  "description": "CEO OS 2.0 — an AI-assisted personal operating system for ambitious people.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
