# ── Required ──────────────────────────────────────────────────────────────
# PostgreSQL connection (CEO OS 2.0 must use its OWN database, never the 1.0 one)
DATABASE_URL=postgres://user:password@host:5432/ceo_os
# Public URL of this deployment, no trailing slash
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# 32 random bytes, base64 — encrypts provider tokens at rest. openssl rand -base64 32
ENCRYPTION_KEY=

# ── Optional ──────────────────────────────────────────────────────────────
# Google OAuth client (enables "Continue with Google" and Google Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Bearer secret for POST /api/cron/sync (background calendar sync)
CRON_SECRET=
# Housecall Pro (MAX plan) read-only API key — server-side only, never entered in the app.
# Bound to exactly one CEO OS account by email.
HOUSECALL_PRO_API_KEY=
HOUSECALL_PRO_ACCOUNT_EMAIL=
